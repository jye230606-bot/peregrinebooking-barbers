# Which tenant this deployment books for. Must match src/config/tenant.ts.
TENANT_SLUG=vbarbers

# Where the diary lives: "file" (a JSON file under .data/, local only — the
# Vercel filesystem is thrown away) or "supabase" (Peregrine's shared project).
STORE=file
# STORE_FILE=.data/vbarbers.json

# Server-only. Never prefix these with NEXT_PUBLIC_. The service-role key
# bypasses row-level security; the browser never talks to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner sign-in at /owner. No defaults: in production the owner routes refuse
# to work until both are set.
#   printf 'the password' | npm run hash-password --silent
# In a .env file, write every $ in the hash as \$ (Next expands $NAME in
# .env files). In the Vercel dashboard, paste it as printed.
OWNER_PASSWORD_HASH=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Read-only calendar feed at /api/calendar/<secret>.ics. Long and random.
CALENDAR_FEED_SECRET=

# Emails via Resend. Optional: without them each email is logged and the
# booking still stands. The from-address's domain must be verified in Resend.
RESEND_API_KEY=
BOOKING_FROM_EMAIL="V Barbers <bookings@example.com>"
# Where Vance's booking alerts go.
OWNER_EMAIL=

# Absolute origin for links in emails, e.g. https://book.vbarbers.com.au
SITE_URL=
