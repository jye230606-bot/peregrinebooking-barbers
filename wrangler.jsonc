{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbarbers",
  "account_id": "f58d6ddc12f9eda04dc964208a9c9806",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "routes": [{ "pattern": "vbarbers.peregrinepartners.space/*", "zone_name": "peregrinepartners.space" }],
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "vars": {
    "EMAIL_PROVIDER": "cloudflare",
    "BOOKING_FROM_EMAIL": "V Barbers <bookings@peregrinepartners.space>",
    "STORE": "supabase",
    "SUPABASE_URL": "https://pzljcmcnthzklaurzxpa.supabase.co",
    "TENANT_SLUG": "vbarbers",
    "SITE_URL": "https://vbarbers.peregrinepartners.space",
    "OWNER_EMAIL": "Vance.christo@icloud.com"
  }
}
